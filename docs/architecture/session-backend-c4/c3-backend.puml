@startuml
!pragma layout smetana
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 140
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title C3 · backend 요청·감사·전달 컴포넌트\n제안 컴포넌트 / 하나의 Spring Boot 앱
Container_Ext(edge, "Nginx", "Reverse proxy", "브라우저 요청")
ContainerDb_Ext(redis, "세션", "Redis", "로그인 상태·회수")
ContainerDb_Ext(db, "업무·감사 DB", "PostgreSQL / zetty_backend", "업무 / 감사 사실 / 전달 작업")
Container_Ext(uba, "UBA 수신", "Python", "인증·저장 후 ACK")
ContainerDb_Ext(logs, "일반 로그", "회전 파일", "마스킹된 운영 기록")
Container_Boundary(b, "backend · 네 Gradle 모듈 / 실행 앱 하나") {
 Component(context, "요청 맥락", "bootstrap-app / filter", "request_id 1회 생성·전파·정리\n신뢰 프록시 IP 판별")
 Component(security, "세션 보안", "bootstrap-app / Spring Security", "인증 복원·현재 상태/authVersion\nCSRF·Origin·기능 권한")
 Component(auth, "로그인·회수", "bootstrap-app + application", "시도 제한·Provider 검증\n세션 ID 교체·로그아웃·회수")
 Component(order, "주문 API·객체 인가", "controller / facade / service", "검증 userId + 주문 소유권 범위 조회")
 Component(audit, "감사 영속 기록", "application + infrastructure", "허용 필드·당시 사실·발생/기록 시각\n감사+전달 대기 원자적 저장")
 Component(delivery, "감사 전달·복구", "job + service + adapters", "초기 worker 1개 / bounded batch\n재시도·중단 복구·조건부 완료")
}
Rel(edge, context, "HTTP 요청")
Rel(context, security, "공유 요청 ID·검증 IP")
Rel(security, redis, "세션 복원")
Rel(security, db, "현재 계정 상태·버전")
Rel(security, auth, "로그인·로그아웃 경로")
Rel(security, order, "인증된 principal")
Rel(auth, redis, "세션 저장·무효화")
Rel(auth, db, "사용자·제한 상태")
Rel(order, db, "orderId + userId 조회")
Rel(auth, audit, "성공·실패·회수의 명시적 기록")
Rel(order, audit, "허용·거부 사실")
Rel(security, audit, "정의한 보호 경로 실패 / 중복 방지")
Rel(audit, db, "audit_events + audit_delivery")
Rel(delivery, db, "짧은 선점·복구·조건부 상태 갱신")
Rel(delivery, uba, "event_id 유지·서비스 Bearer", "SQL 트랜잭션 밖 HTTP")
Rel(context, logs, "request_id 로그 맥락")
Rel(audit, logs, "저장 실패 진단")
Rel(delivery, logs, "event_id·시도 ID·오류 코드")
Lay_D(audit, delivery)
caption 거부 감사는 업무 rollback과 분리 / Redis와 PostgreSQL은 분산 원자성 없음\n공통 오류·DTO·Clock·타입 설정 사용 / 상태·진행 관측은 운영 관측도에서 확대
SHOW_LEGEND()
@enduml
