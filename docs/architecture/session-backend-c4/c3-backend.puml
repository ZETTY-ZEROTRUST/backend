@startuml
!pragma layout smetana
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 150
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title C3 · backend 내부 컴포넌트\nPostgreSQL 설계안 · 구현 전

Container_Ext(edge, "Nginx", "Reverse proxy", "브라우저 요청")
ContainerDb_Ext(redis, "세션 저장소", "Redis", "인증 정보·세션 상태")
ContainerDb_Ext(db, "업무·감사 DB", "PostgreSQL / zetty_backend", "업무 / 감사 / 전달 상태")
Container_Ext(uba, "uba-analyzer", "Python", "저장 후 수신 확인")
Container_Boundary(b, "backend · 하나의 Spring Boot 앱") {
 Component(security, "세션 보안", "bootstrap-app / Spring Security", "인증 복원·현재 계정 상태·CSRF·Origin 검사")
 Component(auth, "로그인·로그아웃", "bootstrap-app + application", "Provider 비밀번호 검증·세션 교체·회수")
 Component(order, "업무 API·객체 인가", "bootstrap-app + application", "인증된 userId로 주문 소유권 검사")
 Component(audit, "감사 기록", "application + infrastructure", "이벤트와 전달 대기를 같은 DB 트랜잭션에 저장")
 Component(delivery, "감사 전달", "job + application + infrastructure", "미전달 조회·재시도·ACK 처리 / 요청 처리와 분리")
 Component(ops, "일반 로깅", "SLF4J / Logback", "운영 오류·전달 장애를 파일에 기록")
}
ContainerDb_Ext(logs, "로그 디렉토리", "File volume", "일반 운영 로그")
Rel(edge, security, "HTTP 요청")
Rel(security, redis, "인증 복원·세션 검사")
Rel(security, db, "현재 계정 상태·인증 버전 확인")
Rel(security, auth, "로그인·로그아웃 경로")
Rel(security, order, "인증된 주체 전달")
Rel(auth, redis, "세션 저장·무효화")
Rel(auth, db, "사용자·비밀번호 해시 조회")
Rel(order, db, "orderId + userId 조건 조회")
Rel(auth, audit, "로그인 결과·종료 기록")
Rel(order, audit, "조회 허용·객체 접근 거부")
Rel(security, audit, "보호 경로 인증 실패 등 / 중복 기록 방지")
Rel(audit, db, "audit_events + audit_delivery INSERT")
Rel(delivery, db, "PENDING 조회·재시도 상태 변경")
Rel(delivery, uba, "event_id 유지 / 중복 전송 가능", "내부 HTTP")
Rel(audit, ops, "저장 실패 진단")
Rel(delivery, ops, "전달 실패 진단")
Rel(ops, logs, "회전 파일 쓰기")

SHOW_LEGEND()
@enduml
